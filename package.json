{
    "name": "tb-config-mate",
    "version": "2.0.2",
    "main": "tb-config-src.js",
    "bin": "tb-config-src.js",
    "pkg": {
        "assets": [
            "index.html",
            "config-meta.js",
            "assets/**/*"
        ],
        "targets": [
            "node18-linux-x64",
            "node18-linux-arm64",
            "node18-macos-x64",
            "node18-win-x64"
        ],
        "outputPath": "dist"
    },
    "scripts": {
        "start": "node tb-config-src.js",
        "dev": "node tb-config-src.js --dev",
        "check": "node scripts/check.js",
        "type-check": "tsc --noEmit",
        "lint": "eslint assets/src/",
        "lint:fix": "eslint assets/src/ --fix",
        "lint:style": "stylelint \"assets/**/*.{css,scss,less,vue,jsx,tsx}\" \"tests/**/*.{css,scss,less,vue,jsx,tsx}\" --allow-empty-input",
        "lint:style:fix": "stylelint \"assets/**/*.{css,scss,less,vue,jsx,tsx}\" \"tests/**/*.{css,scss,less,vue,jsx,tsx}\" --fix --allow-empty-input",
        "format": "prettier --write assets/src/",
        "format:check": "prettier --check assets/src/",
        "ui:check": "bash scripts/ui-check.sh",
        "test:ui": "playwright test -c playwright.config.ts",
        "test:ui:update": "playwright test -c playwright.config.ts --update-snapshots",
        "test:visual:init": "backstop reference --config=backstop.json",
        "test:visual": "backstop test --config=backstop.json",
        "test:visual:approve": "backstop approve --config=backstop.json",
        "test:visual:report": "backstop openReport --config=backstop.json",
        "dist:image-build": "bash scripts/prepare-image-build-dist.sh",
        "clean": "rm -rf dist node_modules/.cache",
        "build": "npm run clean && pkg .",
        "docker:build:base": "docker build -f Dockerfile.base -t tb-config-mate-base:latest .",
        "docker:build": "npm run docker:build:base && docker build -t tb-config-mate:latest .",
        "docker:save": "mkdir -p images && docker save tb-config-mate:latest | gzip > images/tb-config-mate_latest.tar.gz"
    },
    "dependencies": {
        "js-yaml": "^4.1.1",
        "pkg": "^5.8.1"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.60.0",
        "backstopjs": "^6.3.25",
        "eslint": "^10.3.0",
        "globals": "^17.6.0",
        "postcss-html": "^1.8.1",
        "postcss-less": "^6.0.0",
        "postcss-safe-parser": "^7.0.1",
        "postcss-scss": "^4.0.9",
        "postcss-styled-syntax": "^0.7.1",
        "prettier": "^3.8.3",
        "stylelint": "^17.12.0",
        "stylelint-config-standard": "^40.0.0",
        "stylelint-config-standard-scss": "^17.0.0",
        "stylelint-declaration-strict-value": "^1.11.1",
        "typescript": "^5.9.3"
    }
}
