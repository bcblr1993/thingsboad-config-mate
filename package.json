{
    "name": "tb-config-mate",
    "version": "1.4.15",
    "main": "tb-config-src.js",
    "bin": "tb-config-src.js",
    "pkg": {
        "assets": [
            "index.html",
            "config-meta.js",
            "assets/**/*"
        ],
        "targets": [
            "node18-linux-x64",
            "node18-linux-arm64",
            "node18-macos-x64",
            "node18-win-x64"
        ],
        "outputPath": "dist"
    },
    "scripts": {
        "start": "node tb-config-src.js",
        "dev": "node tb-config-src.js --dev",
        "check": "node scripts/check.js",
        "dist:image-build": "bash scripts/prepare-image-build-dist.sh",
        "clean": "rm -rf dist node_modules/.cache",
        "build": "npm run clean && pkg .",
        "docker:build:base": "docker build -f Dockerfile.base -t tb-config-mate-base:latest .",
        "docker:build": "npm run docker:build:base && docker build -t tb-config-mate:latest .",
        "docker:save": "mkdir -p images && docker save tb-config-mate:latest | gzip > images/tb-config-mate_latest.tar.gz"
    },
    "dependencies": {
        "js-yaml": "^4.1.1",
        "pkg": "^5.8.1"
    }
}
