{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "node",

        "allowJs": true,
        "checkJs": true,
        "noEmit": true,

        "strict": false,
        "strictNullChecks": true,
        "noImplicitAny": false,
        "noFallthroughCasesInSwitch": true,
        "noUnusedLocals": false,
        "noUnusedParameters": false,

        "lib": ["ES2022", "DOM", "DOM.Iterable"],
        "skipLibCheck": true,
        "resolveJsonModule": true,
        "isolatedModules": true
    },
    "include": [
        "assets/src/**/*.js",
        "assets/src/**/*.d.ts"
    ]
}
